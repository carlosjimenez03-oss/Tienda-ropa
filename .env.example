# Copia este archivo a .env (local) o pega estas variables en Dokploy → Environment.

# URL pública con HTTPS (obligatoria para PWA y cookies seguras)
PUBLIC_URL=https://inventario.tu-dominio.com

# Base de datos (el contenedor de Postgres se crea con estos valores)
POSTGRES_USER=inventario
POSTGRES_PASSWORD=cambia-esta-clave-larga-y-aleatoria
POSTGRES_DB=inventario

# Cuenta propietaria: se crea solo la primera vez (base vacía), con todos los
# permisos. Al entrar por primera vez la app obliga a cambiar esta contraseña.
ADMIN_EMAIL=tu-correo@ejemplo.com
ADMIN_PASSWORD=contrasena-temporal-de-10-o-mas

# Opcionales
SESSION_DAYS=90
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
