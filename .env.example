# Copia este archivo a .env (local) o pega estas variables en Dokploy → Environment.

# URL pública con HTTPS (obligatoria para PWA, cookies seguras y OAuth)
PUBLIC_URL=https://inventario.tu-dominio.com

# Base de datos (el contenedor de Postgres se crea con estos valores)
POSTGRES_USER=inventario
POSTGRES_PASSWORD=cambia-esta-clave-larga-y-aleatoria
POSTGRES_DB=inventario

# Primera cuenta de administración (solo se usa si la base no tiene usuarias)
ADMIN_EMAIL=duena@tu-dominio.com
ADMIN_PASSWORD=una-contrasena-de-al-menos-10

# Google (opcional). URI de redirección: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (opcional). Return URL: <PUBLIC_URL>/api/auth/apple/callback
# APPLE_CLIENT_ID es el Services ID, p. ej. com.tudominio.inventario.web
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contenido del .p8 en una línea, con \n en lugar de saltos de línea
APPLE_PRIVATE_KEY=

# Opcionales
SESSION_DAYS=90
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
